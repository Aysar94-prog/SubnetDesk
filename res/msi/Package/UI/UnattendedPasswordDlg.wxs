<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?include ../Includes.wxi?>
  <Fragment>
    <UI>
      <Dialog Id="UnattendedPasswordDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="Unattended access password" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="310" Height="15" Transparent="yes" NoPrefix="yes" Text="Enter a new password to replace this device's existing unattended password." />
        <Control Id="SetPasswordCheckBox" Type="CheckBox" X="25" Y="45" Width="300" Height="17" Property="SET_UNATTENDED_PASSWORD" CheckBoxValue="1" Text="Set or replace unattended password" />
        <Control Id="PasswordLabel" Type="Text" X="25" Y="75" Width="100" Height="15" Text="Password:" />
        <Control Id="PasswordEdit" Type="Edit" X="25" Y="90" Width="220" Height="18" Property="UNATTENDED_PASSWORD" Password="yes" Disabled="yes" EnableCondition="SET_UNATTENDED_PASSWORD=1" DisableCondition="SET_UNATTENDED_PASSWORD&lt;&gt;1" />
        <Control Id="ConfirmLabel" Type="Text" X="25" Y="120" Width="140" Height="15" Text="Confirm password:" />
        <Control Id="ConfirmEdit" Type="Edit" X="25" Y="135" Width="220" Height="18" Property="UNATTENDED_PASSWORD_CONFIRM" Password="yes" Disabled="yes" EnableCondition="SET_UNATTENDED_PASSWORD=1" DisableCondition="SET_UNATTENDED_PASSWORD&lt;&gt;1" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <!-- An unchecked option must not leave a previously entered password pending. -->
          <Publish Property="UNATTENDED_PASSWORD" Value="{}" Condition="SET_UNATTENDED_PASSWORD&lt;&gt;1" Order="1" />
          <Publish Property="UNATTENDED_PASSWORD_CONFIRM" Value="{}" Condition="SET_UNATTENDED_PASSWORD&lt;&gt;1" Order="2" />
          <Publish Event="SpawnDialog" Value="UnattendedPasswordRequiredDlg" Condition="SET_UNATTENDED_PASSWORD=1 AND (UNATTENDED_PASSWORD=&quot;&quot; OR UNATTENDED_PASSWORD_CONFIRM=&quot;&quot;)" Order="3" />
          <Publish Event="SpawnDialog" Value="UnattendedPasswordMismatchDlg" Condition="SET_UNATTENDED_PASSWORD=1 AND UNATTENDED_PASSWORD&lt;&gt;&quot;&quot; AND UNATTENDED_PASSWORD_CONFIRM&lt;&gt;&quot;&quot; AND UNATTENDED_PASSWORD&lt;&gt;UNATTENDED_PASSWORD_CONFIRM" Order="4" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Condition="SET_UNATTENDED_PASSWORD&lt;&gt;1 OR (UNATTENDED_PASSWORD&lt;&gt;&quot;&quot; AND UNATTENDED_PASSWORD_CONFIRM&lt;&gt;&quot;&quot; AND UNATTENDED_PASSWORD=UNATTENDED_PASSWORD_CONFIRM)" Order="5" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1" />
        </Control>
      </Dialog>
      <Dialog Id="UnattendedPasswordRequiredDlg" Width="260" Height="85" Title="Unattended access">
        <Control Id="Message" Type="Text" X="15" Y="15" Width="230" Height="30" Text="Enter and confirm the unattended access password." />
        <Control Id="OK" Type="PushButton" X="100" Y="55" Width="60" Height="17" Default="yes" Text="OK"><Publish Event="EndDialog" Value="Return" Condition="1" /></Control>
      </Dialog>
      <Dialog Id="UnattendedPasswordMismatchDlg" Width="260" Height="85" Title="Unattended access">
        <Control Id="Message" Type="Text" X="15" Y="15" Width="230" Height="30" Text="The passwords do not match. Enter them again." />
        <Control Id="OK" Type="PushButton" X="100" Y="55" Width="60" Height="17" Default="yes" Text="OK"><Publish Event="EndDialog" Value="Return" Condition="1" /></Control>
      </Dialog>
    </UI>
    <!-- An unchecked MSI checkbox must have an unset property, not the string 0. -->
    <Property Id="SET_UNATTENDED_PASSWORD" Secure="yes" />
    <Property Id="ENABLE_UNATTENDED" Secure="yes" />
    <Property Id="UNATTENDED_PASSWORD" Secure="yes" Hidden="yes" />
    <Property Id="UNATTENDED_PASSWORD_B64" Secure="yes" Hidden="yes" />
    <Property Id="UNATTENDED_PASSWORD_CONFIRM" Secure="yes" Hidden="yes" />
  </Fragment>
</Wix>
