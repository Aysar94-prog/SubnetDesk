			</Component>
			<Component Guid="8b61a0c0-7177-4c01-b4d4-0c2c6d06f47e" Subdirectory="data">
				<File Source="D:/Projects AI/SubnetDesk-Helper/output/release-helper-1.4.5-build121/HelperBundle/data/app.so" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="78a22b6b-de37-49d3-be99-c801edf81b3b" Subdirectory="data">
				<File Source="D:/Projects AI/SubnetDesk-Helper/output/release-helper-1.4.5-build121/HelperBundle/data/icudtl.dat" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="14339884-decc-4261-b607-f309cb28eb5e" Subdirectory="data\flutter_assets">
				<File Source="D:/Projects AI/SubnetDesk-Helper/output/release-helper-1.4.5-build121/HelperBundle/data/flutter_assets/AssetManifest.bin" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="76a10111-0c14-4fb2-8088-c20909e9e450" Subdirectory="data\flutter_assets">
				<File Source="D:/Projects AI/SubnetDesk-Helper/output/release-helper-1.4.5-build121/HelperBundle/data/flutter_assets/FontManifest.json" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="48bc59b5-aeec-4ef3-9b4b-933d89c2f892" Subdirectory="data\flutter_assets">
				<File Source="D:/Projects AI/SubnetDesk-Helper/output/release-helper-1.4.5-build121/HelperBundle/data/flutter_assets/NativeAssetsManifest.json" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="28ac1aae-7a24-4ad4-997d-6063ad7d7deb" Subdirectory="data\flutter_assets">
				<File Source="D:/Projects AI/SubnetDesk-Helper/output/release-helper-1.4.5-build121/HelperBundle/data/flutter_assets/NOTICES.Z" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="fe8f2781-1a6d-448d-ab1a-bbf0fa7648be" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/Projects AI/SubnetDesk-Helper/output/release-helper-1.4.5-build121/HelperBundle/data/flutter_assets/assets/actions.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="9b7b6b2a-633e-4fbc-af1f-64973d41514c" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/Projects AI/SubnetDesk-Helper/output/release-helper-1.4.5-build121/HelperBundle/data/flutter_assets/assets/actions_mobile.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="1defcd4f-bd62-45b2-8a96-ed1fae422b1e" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/Projects AI/SubnetDesk-Helper/output/release-helper-1.4.5-build121/HelperBundle/data/flutter_assets/assets/address_book.ttf" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="76d2d888-532d-4418-bc12-87447142a4e0" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/Projects AI/SubnetDesk-Helper/output/release-helper-1.4.5-build121/HelperBundle/data/flutter_assets/assets/android.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="2104b7aa-e40b-4441-8cda-e75247f5ee48" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/Projects AI/SubnetDesk-Helper/output/release-helper-1.4.5-build121/HelperBundle/data/flutter_assets/assets/arrow.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="eea25aca-e2b1-4b18-817e-f8d30bdc068c" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/Projects AI/SubnetDesk-Helper/output/release-helper-1.4.5-build121/HelperBundle/data/flutter_assets/assets/auth-apple.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="b85079f9-8d07-4899-af1f-9f93f7c7248f" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/Projects AI/SubnetDesk-Helper/output/release-helper-1.4.5-build121/HelperBundle/data/flutter_assets/assets/auth-auth0.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="45049ce1-ee56-4ff7-b9cc-6a4de7c5d776" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/Projects AI/SubnetDesk-Helper/output/release-helper-1.4.5-build121/HelperBundle/data/flutter_assets/assets/auth-default.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="2722aab6-d888-4a50-a87f-fe0e6c00fe82" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/Projects AI/SubnetDesk-Helper/output/release-helper-1.4.5-build121/HelperBundle/data/flutter_assets/assets/auth-facebook.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="d7a8815e-7f05-473b-8d22-4ee86f3f861d" Subdirectory="data\flutter_assets\assets">
