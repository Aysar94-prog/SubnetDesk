			</Component>
			<Component Guid="3d63521e-cdbc-4f93-9ba3-b7157712d715" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/Projects AI/SubnetDesk-Helper/output/release-helper-1.4.5-build121/HelperBundle/data/flutter_assets/assets/auth-gitlab.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="6d495994-9b84-40a1-8251-2dd98b1e933e" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/Projects AI/SubnetDesk-Helper/output/release-helper-1.4.5-build121/HelperBundle/data/flutter_assets/assets/auth-google.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="889a59df-b611-418a-9781-52926c12156e" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/Projects AI/SubnetDesk-Helper/output/release-helper-1.4.5-build121/HelperBundle/data/flutter_assets/assets/auth-microsoft.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="1213128c-b60a-4b84-be71-5eaa7772d2ea" Subdirectory="data\flutter_assets\assets">
