<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- A distinct machine product: MSI cannot upgrade across installation contexts. -->
  <Package Name="SubnetDesk Helper" Manufacturer="SubnetDesk Private Build"
           Version="$(var.ReleaseVersion)" Language="1033" Scope="perMachine"
           UpgradeCode="0351f62f-54c5-42be-b162-c4f2088e7c39" InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer SubnetDesk Helper is already installed."
                  Schedule="afterInstallInitialize" AllowSameVersionUpgrades="no" />
    <Property Id="OLD_USER_HELPER" Secure="yes">
      <RegistrySearch Id="FindOldUserHelper" Root="HKCU"
                      Key="Software\SubnetDeskPrivate\HelperInstaller"
                      Name="Shortcut" Type="raw" />
    </Property>
    <Launch Condition="Installed OR NOT OLD_USER_HELPER"
            Message="Uninstall the previous per-user SubnetDesk Helper from Settings &gt; Apps first. Your application settings are preserved." />
    <Launch Condition="VersionNT64" Message="SubnetDesk Helper requires 64-bit Windows." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="HELPER_BUILD" Value="$(var.ReleaseBuild)" />
    <Property Id="ARPCOMMENTS" Value="Private helper $(var.ReleaseVersion), build $(var.ReleaseBuild). Updates disabled. Administrator installation." />
    <Property Id="ARPHELPLINK" Value="https://github.com/zibo-chen/SubnetDesk" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SubnetDeskHelper" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="HelperMenu" Name="SubnetDesk Helper" />
    </StandardDirectory>
    <Feature Id="Complete" Title="SubnetDesk Helper" Level="1">
      <ComponentGroupRef Id="HelperPayload" />
    </Feature>
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <ui:WixUI Id="WixUI_Minimal" />
  </Package>
</Wix>
